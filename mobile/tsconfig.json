{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@timeline/*": [
        "../src/core/timeline/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@audio/*": [
        "../src/core/audio/*"
      ],
      "@ai/*": [
        "../src/core/ai/*"
      ],
      "@agent/*": [
        "../src/core/agent/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
